{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@/*": [
        "src/renderer/src/*"
      ],
      // Esta config e a do alvo DESKTOP: aqui `@platform` e o Electron, igual ao
      // alias de `electron.vite.config.ts`. O espelho do alvo web esta em
      // `tsconfig.web-target.json`, que sobrescreve SO esta linha.
      "@platform/*": [
        "src/renderer/src/platform/electron/*"
      ]
    }
  }
}
